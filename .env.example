# Local Mac futures mode (recommended)
MARKET_TYPE=linear
BTC_DATA_DIR=work/runtime-local
PORT=8000
# Direct futures access is primary. BINANCE_WS_PROXY_URL or
# QUOTAGUARDSTATIC_URL remains an optional override.
BINANCE_PROXY_REQUIRED=0
BINANCE_WS_HEARTBEAT_TIMEOUT_SECONDS=35
BINANCE_WS_RECONNECT_BASE_SECONDS=5
BINANCE_WS_RECONNECT_MAX_SECONDS=120
BINANCE_WS_RECONNECT_JITTER_MIN=0.80
BINANCE_WS_RECONNECT_JITTER_MAX=1.20
BINANCE_WS_STALE_ALERT_SECONDS=90
PUSH_LAG_ALERT_SECONDS=300

# REST performs one startup backfill and one gap recovery per WS outage.
BINANCE_REST_ENABLED=1
BINANCE_REST_STARTUP_BACKFILL=1
BINANCE_REST_GAP_RECOVERY=1
BINANCE_REST_GAP_SECONDS=45
BINANCE_REST_ERROR_RETRY_SECONDS=60
BINANCE_REST_WEIGHT_CAP=1200
COLLECTOR_STALE_SECONDS=90
BINANCE_TRADE_LIMIT=100
BINANCE_FLOW_LIMIT=60
BYBIT_WS_RECONNECT_SECONDS=5

# Live loop pacing
LIVE_POLL_SECONDS=45
LIVE_WATCHDOG_MISSED_POLLS=3
LIVE_WATCHDOG_CHECK_SECONDS=15
START_LIVE_LOOP_ON_BOOT=1
LIVE_BOOT_RETRY_SECONDS=5
PUSH_COOLDOWN_SECONDS=60
TRADE_LOOKBACK_MINUTES=30
LOG_LEVEL=INFO
LIVE_SUMMARY_LOG_SECONDS=300
TRADE_RETENTION_MINUTES=120
TRADE_QUERY_LIMIT=20000
TRADE_STORE_MAX_ROWS=40000

# Paper economics (match research backtest defaults)
PAPER_FEE_BPS=5
PAPER_SLIPPAGE_BPS=2
PAPER_APPLY_RESEARCH_COSTS=1
PAPER_RISK_FRACTION=0.0025
PAPER_MAX_NOTIONAL_MULTIPLE=1.0
PAPER_DAILY_LOSS_R=2.0
PAPER_WEEKLY_LOSS_R=4.0
PAPER_SOFT_FILTERS=1
PAPER_SOFT_MAX_RR=2.5
PAPER_ROUND_MAGNET_PCT=0.001
PAPER_WIDE_STOP_PCT=0.0035
PAPER_SHADOW_RULE=skip_untested_breakout
PAPER_MIN_CLOSED_BEFORE_RETUNE=40
PAPER_RETUNE_CALENDAR_DAYS=90
PAPER_MAX_HOLD_HOURS=12
PAPER_SAME_SIDE_COOLDOWN_HOURS=8
PAPER_FILL_MIN_RR=1.5
USE_FIXED_PCT_EXITS=1
FIXED_STOP_PCT=0.01
FIXED_TARGET_PCT=0.02
RETRACE_ENTRY_ATR=1.2
RETRACE_PCT=0.5
# FLOW_GATE_MODE=independent
# Do not retune 0.40 thresholds from small live n.

# Optional
# VAPID_SUBJECT=mailto:you@example.com
# ADMIN_API_TOKEN=change-me
