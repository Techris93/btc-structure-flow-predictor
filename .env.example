# Local Mac futures mode (recommended)
MARKET_TYPE=linear
BTC_DATA_DIR=work/runtime-local
PORT=8000
# Local Macs may use direct futures access; Render sets this to 1 and requires
# BINANCE_WS_PROXY_URL or QUOTAGUARDSTATIC_URL.
BINANCE_PROXY_REQUIRED=0
BINANCE_WS_HEARTBEAT_TIMEOUT_SECONDS=35
BINANCE_WS_STALE_ALERT_SECONDS=90
PUSH_LAG_ALERT_SECONDS=300

# Keep Binance REST off by default. Live trades come from WebSockets.
# Only enable REST if the WebSocket buffer needs occasional backfill.
BINANCE_REST_ENABLED=0
BINANCE_REST_ON_STALE=1
BINANCE_STALE_REST_MINUTES=10
COLLECTOR_STALE_SECONDS=90
BINANCE_REST_MINUTES=15
BINANCE_TRADE_LIMIT=100
BINANCE_FLOW_LIMIT=60
BINANCE_WS_RECONNECT_SECONDS=15
BINANCE_WS_RECONNECT_MAX_SECONDS=120
BYBIT_WS_RECONNECT_SECONDS=5

# Live loop pacing
LIVE_POLL_SECONDS=45
LIVE_WATCHDOG_MISSED_POLLS=3
LIVE_WATCHDOG_CHECK_SECONDS=15
START_LIVE_LOOP_ON_BOOT=1
LIVE_BOOT_RETRY_SECONDS=5
PUSH_COOLDOWN_SECONDS=60
TRADE_LOOKBACK_MINUTES=30
LOG_LEVEL=INFO
LIVE_SUMMARY_LOG_SECONDS=300
TRADE_RETENTION_MINUTES=120
TRADE_QUERY_LIMIT=20000
TRADE_STORE_MAX_ROWS=40000

# Optional
# VAPID_SUBJECT=mailto:you@example.com
# ADMIN_API_TOKEN=change-me
